# Envrinmonet files
**/.env*

# Python-generated files
**/__pycache__
*.py[oc]
**/build/
**/dist/
**/wheels/
**/*.egg-info

# Virtual environments
**/.venv

# Logs
logs/*
!logs/.gitkeep

# Data
data/*
!data/.gitkeep

# Jobs
jobs/*
!jobs/.gitkeep

# Tool caches
.ruff_cache/
.ty_cache/

# Web tools
**/node_modules
**/.svelte_kit
**/.vscode

# ORCA binaries
orca_bin/*
!orca_bin/.gitkeep
